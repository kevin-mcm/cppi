# Linux arm64 cross-compiled from x86-64, tests run under qemu-user.
# Requires: g++-aarch64-linux-gnu, qemu-user (Debian/Ubuntu packages).
# A proxy for Android/iOS arm64 that can run anywhere.
#
# Author: kevin-mcm <kevincardenasmiranda9@gmail.com>
# Date:   2026-10-08
include(ci)

[settings]
arch=armv8

[conf]
tools.build:compiler_executables={"c": "aarch64-linux-gnu-gcc", "cpp": "aarch64-linux-gnu-g++"}
tools.cmake.cmaketoolchain:extra_variables={"CMAKE_CROSSCOMPILING_EMULATOR": "qemu-aarch64;-L;/usr/aarch64-linux-gnu"}
